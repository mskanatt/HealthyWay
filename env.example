# Copy this file to .env and fill in your real key.
# Get a key at https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model without touching code.
# Check https://ai.google.dev/gemini-api/docs/models for the current
# recommended vision-capable model, since Gemini's lineup changes over time.
GEMINI_MODEL=gemini-2.5-flash

# Optional: change the local port
PORT=3000